# Tailscale MCP Server

# Preferred Tailscale API auth
TAILSCALE_OAUTH_CLIENT_ID=your-oauth-client-id
TAILSCALE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Compatibility auth alternative
# TAILSCALE_API_KEY=tskey-api-...

# Tailnet shorthand "-" uses the credential's default tailnet
TAILSCALE_TAILNET=-
TAILSCALE_API_BASE_URL=https://api.tailscale.com
TAILSCALE_CLI_PATH=tailscale

# stdio is safest for local MCP clients
MCP_TRANSPORT=stdio

# HTTP mode is private-by-default and requires bearer auth
# MCP_TRANSPORT=http
# MCP_HTTP_BIND_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_BEARER_TOKEN=replace-with-32-plus-random-chars
# MCP_ALLOWED_HOSTS=mcp.your-tailnet.ts.net

# Tool risk gate: read, write, admin
TAILSCALE_ALLOWED_TOOL_RISK=read

# Logging writes to stderr unless a file is configured
LOG_LEVEL=info
# MCP_SERVER_LOG_FILE=logs/tailscale-mcp-server.log
